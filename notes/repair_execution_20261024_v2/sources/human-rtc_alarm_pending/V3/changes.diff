--- V0/subjects/upstream/zephyr/tests/drivers/rtc/rtc_api/src/test_alarm.c
+++ V3/subjects/upstream/zephyr/tests/drivers/rtc/rtc_api/src/test_alarm.c
@@ -10,6 +10,9 @@
 #include <zephyr/drivers/rtc.h>
 #include <zephyr/sys/atomic.h>
 #include <zephyr/sys/util.h>
+
+#define REPAIR_EVENT_WAIT 1
+#include "repair_wait.h"
 
 #define RTC_TEST_ALARM_TEST_NOT_PENDING_DELAY (3)
 #define RTC_TEST_ALARM_TEST_PENDING_DELAY     (10)
@@ -66,6 +69,47 @@
 	RTC_ALARM_TIME_MASK_NSEC
 };
 
+static int repair_cmp(const struct rtc_time *a, const struct rtc_time *b)
+{
+    const int av[] = {a->tm_year,a->tm_mon,a->tm_mday,a->tm_hour,a->tm_min,a->tm_sec};
+    const int bv[] = {b->tm_year,b->tm_mon,b->tm_mday,b->tm_hour,b->tm_min,b->tm_sec};
+    for (size_t i=0; i<ARRAY_SIZE(av); ++i) {
+        if (av[i] != bv[i]) { return av[i] < bv[i] ? -1 : 1; }
+    }
+    return 0;
+}
+static int repair_pending[DT_PROP(DT_ALIAS(rtc), alarms_count)];
+static void repair_wait_pending(void)
+{
+    for (uint16_t id = 0; id < alarms_count; ++id) {
+        repair_pending[id] = 0;
+    }
+    while (!repair_expired()) {
+        bool complete = true;
+        for (uint16_t id = 0; id < alarms_count; ++id) {
+            if (repair_pending[id] != 1) {
+                struct rtc_time repair_before, repair_after;
+                zassert_ok(rtc_get_time(rtc, &repair_before));
+                int status = rtc_alarm_is_pending(rtc, id);
+                zassert_ok(rtc_get_time(rtc, &repair_after));
+                if (status > 0) {
+                    zassert_true(repair_cmp(&repair_after, &test_alarm_time_set) >= 0,
+                                 "Pending before configured RTC target");
+                }
+                repair_pending[id] = status;
+                if (status < 0) {
+                    return;
+                }
+            }
+            complete &= repair_pending[id] == 1;
+        }
+        if (complete) {
+            return;
+        }
+        k_sleep(K_MSEC(20));
+    }
+}
+
 ZTEST(rtc_api, test_alarm)
 {
 	int ret;
@@ -195,11 +239,11 @@
 		}
 
 		/* Wait for alarm to trigger */
-		k_sleep(K_SECONDS(RTC_TEST_ALARM_TEST_PENDING_DELAY));
-
-		/* Validate alarm is pending */
+		repair_wait_pending();
+
+		/* Validate alarm is pending; the state wait latched consuming reads. */
 		for (uint16_t i = 0; i < alarms_count; i++) {
-			ret = rtc_alarm_is_pending(rtc, i);
+			ret = repair_pending[i];
 			zassert_equal(ret, 1, "Alarm %d should be pending", i);
 		}
 	}
